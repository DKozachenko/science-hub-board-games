{
  "name": "science-hub-board-games",
  "version": "0.0.0",
  "scripts": {
    "start": "ng serve",
    "----------------BUILD----------------": "",
    "build:development": "ng build --configuration=development",
    "build:production": "ng build --configuration=production",
    "----------------LINT----------------": "",
    "lint": "eslint ./src --config ./configs/eslint/eslint.config.ts",
    "stylelint": "stylelint './src/**/*.{scss,css}' --config ./configs/stylelint/stylelint.config.js",
    "presteiger": "cp ./configs/steiger/steiger.config.ts ./steiger.config.ts",
    "steiger": "steiger ./src",
    "poststeiger": "rm ./steiger.config.ts",
    "----------------LINT-STAGED----------------": "",
    "lint-staged": "lint-staged --config ./configs/lint-staged/.lintstagedrc.json"
  },
  "private": true,
  "packageManager": "npm@10.8.2",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@angular/common": "21.1.1",
    "@angular/compiler": "21.1.1",
    "@angular/core": "21.1.1",
    "@angular/forms": "21.1.1",
    "@angular/platform-browser": "21.1.1",
    "@angular/router": "21.1.1",
    "date-fns": "4.1.0",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "21.1.1",
    "@angular/cli": "21.1.1",
    "@angular/compiler-cli": "21.1.1",
    "@feature-sliced/steiger-plugin": "0.5.7",
    "@tailwindcss/postcss": "4.1.12",
    "angular-eslint": "21.1.0",
    "cz-conventional-changelog": "3.3.0",
    "cz-customizable": "7.5.1",
    "eslint": "9.39.2",
    "eslint-import-resolver-typescript": "4.4.4",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-prettier": "5.5.5",
    "husky": "9.1.7",
    "jiti": "2.6.1",
    "lint-staged": "16.2.7",
    "postcss": "8.5.3",
    "prettier": "3.8.1",
    "steiger": "0.5.11",
    "stylelint": "17.0.0",
    "stylelint-config-standard-scss": "17.0.0",
    "stylelint-prettier": "5.0.3",
    "tailwindcss": "4.1.12",
    "typescript": "5.9.3",
    "typescript-eslint": "8.53.1"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-customizable"
    },
    "cz-customizable": {
      "config": "./configs/commitizen/commitizen.config.js"
    }
  }
}
